{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tollgate hook-profile-changed-note",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tollgate hook-profile-changed-note",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "tollgate self-heal",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_tollgate_tollgate__delegate$",
        "hooks": [
          {
            "type": "command",
            "command": "tollgate mcp-await-job",
            "asyncRewake": true,
            "timeout": 4260,
            "rewakeMessage": "A backgrounded tollgate delegate finished; its result envelope follows.",
            "rewakeSummary": "tollgate delegate results"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "tollgate hook-profile-changed-note",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
